# Copy to .env and fill locally. Never commit real keys.

# ElevenLabs — B-Roll narrator (Piotr v3 recommended)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=gFl0NeqphJUaoBLtWrqM
ELEVENLABS_MODEL_ID=eleven_v3

# Chrome CDP for Google Flow automation
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_USER_DATA=
# Leave empty to use %LOCALAPPDATA%\Google\Chrome\User Data
CHROME_PROFILE=Profile 60
CDP_URL=http://127.0.0.1:9222
FLOW_URL=https://flow.google.com/

# Optional sibling repo for chronicle maps / motion graphics
MOTION_LIB_PATH=../motion-lib
